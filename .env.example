# Copy to .env.local for development. Never copy production or staging secrets here.
# Development DATABASE_URL must point at a throwaway/local SQLite file only.
# Staging and production secrets belong in their respective Netlify/deployment secret stores.

# Application / database
NODE_ENV=development
# Dedicated disposable local file; never point at existing prisma/dev.db.
# Guarded schema/seed commands require this target plus PHASE21_SANDBOX_CONFIRM=YES.
# Staging/production PostgreSQL requirement (Phase 36 / PG-35-01): Prisma
# ignores sslmode for certificate verification, so production refuses to start
# unless the URL sets sslaccept=strict and sslcert=<path to CA>, e.g.
#   postgresql://user:pass@host:5432/db?sslmode=require&sslcert=/certs/ca.pem&sslaccept=strict
# SQLite (development/test) is unaffected.
DATABASE_URL=file:./phase21-sandbox.db
PUBLIC_APP_URL=http://localhost:3000
ORG_TIMEZONE=UTC

# Reverse-proxy trust (Phase 43 / F-01). Empty or 0 means no forwarded header is
# trusted: the client IP is unknown and login rate limiting is keyed by account
# identifier only. Set this to the number of proxy hops in front of the app
# (usually 1 for a single nginx/ALB) so the client IP can be taken from
# X-Forwarded-For and recorded in the audit trail. Never set it larger than the
# real hop count, and never expose the app directly while it is greater than 0.
# TRUSTED_PROXY_HOPS=1

# Legacy/manual local test scripts only; do not use these as deployment URLs.
# BASE=http://127.0.0.1:3000
# BASE_URL=http://127.0.0.1:3000
# NETLIFY and CONTEXT are platform-injected deployment metadata; do not set manually.

# Authentication. Generate fresh random values; never reuse between environments.
SESSION_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32
INTEGRATION_SECRET_KEY=replace-with-a-separate-32-byte-random-key

# Login UI: only affects non-production demo hint visibility. Keep false outside local dev.
NEXT_PUBLIC_DEMO_HINTS=false

# AI tutor (server-only). Leave blank to use the built-in/local fallback.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional teacher content drafting provider (server-only; webhook must be trusted).
AI_CONTENT_PROVIDER=none
AI_CONTENT_WEBHOOK_URL=

# Speech providers (server-only). Empty values leave user-facing fallback available.
STT_API_KEY=
STT_BASE_URL=
TTS_API_KEY=
TTS_BASE_URL=

# Notifications. Webhook endpoints must be HTTPS and controlled by your organization.
EMAIL_PROVIDER=none
EMAIL_WEBHOOK_URL=
SMS_PROVIDER=none
SMS_WEBHOOK_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Storage infrastructure - Phase 30
# Provider: local (default for dev and staging), memory (tests ONLY).
# "s3" is REJECTED by configuration validation until a complete adapter is
# implemented and verified (Phase 36 / PG-35-02) - every S3 operation currently
# throws, so selecting it would produce an application that looks healthy and
# fails on the first upload.
# Staging and production require a PERSISTENT filesystem for STORAGE_LOCAL_ROOT.
STORAGE_PROVIDER=local
# Local filesystem root - must be separate per environment
STORAGE_LOCAL_ROOT=./storage
# Staging-specific root to prevent prod overlap (set in staging env only)
STORAGE_STAGING_ROOT=
# S3 / S3-compatible configuration - NOT USABLE YET (reserved for a future
# complete adapter; setting STORAGE_PROVIDER=s3 is rejected in this release)
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false
# Signed URL expiry in seconds (1-3600, default 300)
STORAGE_SIGNED_URL_EXPIRY=300

# Backup & Recovery - Phase 31 (staging-only, never production)
BACKUP_DESTINATION=./backups
BACKUP_DESTINATION_PROD=
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_AT_REST=false
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=5
BACKUP_RECOVERY_DIR=./backups/recovery
# Isolated disposable database used to verify restores. Must differ from DATABASE_URL.
BACKUP_RECOVERY_DATABASE_URL=
# Optional libpq-flavor connection string used ONLY by pg_dump/pg_restore.
# Prisma and libpq need different TLS parameters (Phase 36 / PG-35-03), so when
# DATABASE_URL uses sslaccept=strict this tooling URL must use
# sslmode=verify-full plus sslrootcert pointing at the same CA.
# Leave empty to derive it automatically from DATABASE_URL.
BACKUP_TOOLING_DATABASE_URL=
BACKUP_S3_USE_VERSIONING=false
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_EMAIL=
BACKUP_ALERT_SLACK=
BACKUP_SCHEDULE=

# Background workflow worker. Configure only with a trusted scheduler and server secret.
WORKFLOW_WORKER_SECRET=

# Seed-only guards. Never set these in staging/production deployment environments.
# Schema/data scripts additionally require DATABASE_URL=file:./phase21-sandbox.db and this confirmation.
PHASE21_SANDBOX_CONFIRM=
ALLOW_DEMO_SEED=false
PHASE20_SEED_CONFIRM=
PHASE20_QA_SEED_CONFIRM=

{
  "name": "englishbridge-lms",
  "version": "0.1.0",
  "private": true,
  "description": "EnglishBridge - organizational English learning management system (Phase 1 foundation)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "node scripts/db/guarded-dev-db.mjs push",
    "db:seed": "node scripts/db/guarded-dev-db.mjs seed",
    "db:reset": "node scripts/db/guarded-dev-db.mjs reset",
    "typecheck": "node --max-old-space-size=2048 ./node_modules/typescript/bin/tsc --noEmit",
    "production:check-env": "node scripts/production/check-env.mjs",
    "test:book-import-preview": "tsx scripts/test-book-import-preview.ts",
    "test:session-rules": "tsx scripts/test-session-rules.ts",
    "db:seed:phase20": "node scripts/db/guarded-dev-db.mjs phase20",
    "db:seed:phase20-qa": "node scripts/db/guarded-dev-db.mjs qa",
    "lint": "eslint src",
    "test": "npm run test:session-rules && npm run test:book-import-preview && node scripts/test-production-env.mjs && npm run test:environment && npm run test:db-tls && npm run test:api-safety && npm run test:request-trust && npm run test:staging-gate && npm run test:release-contracts && npm run test:phase46 && npm run test:phase47 && npm run test:phase50",
    "db:validate": "prisma validate",
    "test:environment": "node --conditions=react-server --import tsx scripts/test-server-env.ts",
    "test:api-safety": "tsx scripts/test-api-safety.ts",
    "test:request-trust": "tsx scripts/test-request-trust.ts",
    "db:migrate:status": "node scripts/db/guarded-migrate.mjs status",
    "db:migrate:deploy": "node scripts/db/guarded-migrate.mjs deploy",
    "db:rehearse": "node scripts/db/rehearse-migration.mjs",
    "db:verify": "node scripts/db/verify-db.mjs prisma/dev.db e2e/mig33/rehearsal-clean.db",
    "db:build:sqlite-migrations": "node scripts/db/build-sqlite-migrations.mjs",
    "test:idor-live": "node scripts/test-idor-live.mjs",
    "test:auth-hardening-live": "node scripts/test-auth-hardening-live.mjs",
    "db:p2022": "node scripts/db/p2022-check.mjs e2e/mig33/rehearsal-clean.db",
    "db:restore:postgresql": "node scripts/db/restore-postgresql-migrations.mjs",
    "test:db-tls": "tsx scripts/test-db-tls.ts",
    "test:storage": "tsx scripts/test-storage-regression-simple.mjs",
    "test:backup": "tsx scripts/test-backup-recovery.mjs",
    "staging:ready": "node scripts/db/staging-readiness.mjs",
    "test:staging-gate": "node scripts/test-staging-gate.mjs",
    "test:release-contracts": "tsx scripts/test-release-contracts.ts",
    "build:safe": "NODE_OPTIONS=--max-old-space-size=1400 npm run build",
    "release:verify": "npm run typecheck && npm test && npm run build:safe",
    "runtime:setup": "node scripts/runtime/setup-node.mjs",
    "runtime:check": "node scripts/runtime/setup-node.mjs --check",
    "test:phase46": "tsx scripts/test-phase46-regressions.ts",
    "test:phase47": "tsx scripts/test-phase47-loading-boundaries.ts",
    "test:phase50": "tsx scripts/test-phase50-audio.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.454.0",
    "next": "15.5.27",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18.3.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.29",
    "prisma": "^5.22.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "postcss": "8.5.29"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.13.0 <23.0.0"
  }
}
